{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/mi-proceso",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/curso-de-milagros", "destination": "/curso-de-milagros/index.html" },
    { "source": "/curso-de-milagros/", "destination": "/curso-de-milagros/index.html" },
    { "source": "/sala-reduccion-ego", "destination": "/sala-reduccion-ego/index.html" },
    { "source": "/sala-reduccion-ego/", "destination": "/sala-reduccion-ego/index.html" },
    { "source": "/entrega-de-pasos", "destination": "/entrega-de-pasos/index.html" },
    { "source": "/entrega-de-pasos/", "destination": "/entrega-de-pasos/index.html" },
    { "source": "/sesion-coach", "destination": "/sesion-coach/index.html" },
    { "source": "/sesion-coach/", "destination": "/sesion-coach/index.html" },
    { "source": "/alexandra-ortega", "destination": "/alexandra-ortega/index.html" },
    { "source": "/alexandra-ortega/", "destination": "/alexandra-ortega/index.html" },
    { "source": "/fundacion", "destination": "/fundacion/index.html" },
    { "source": "/fundacion/", "destination": "/fundacion/index.html" },
    { "source": "/politica-de-privacidad", "destination": "/politica-de-privacidad/index.html" },
    { "source": "/politica-de-privacidad/", "destination": "/politica-de-privacidad/index.html" },
    { "source": "/contacto", "destination": "/contacto/index.html" },
    { "source": "/contacto/", "destination": "/contacto/index.html" },
    { "source": "/mi-proceso", "destination": "/index.html" },
    { "source": "/mi-proceso/", "destination": "/index.html" }
  ]
}
