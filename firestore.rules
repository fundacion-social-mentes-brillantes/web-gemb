rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'fundacionsocial@gimnasioemocionalmb.com';
    }

    function isValidTestType(testType) {
      return testType in [
        'initial-assessment',
        'enneagram-quick',
        'enneagram-full'
      ];
    }

    function isValidFollowUpStatus(status) {
      return status in [
        'new',
        'contacted',
        'scheduled',
        'in_process',
        'in_progress',
        'closed'
      ];
    }

    function isValidLeadCreate() {
      return request.auth != null &&
        request.resource.data.keys().hasOnly([
          'testType',
          'testVersion',
          'createdByUid',
          'contact',
          'consent',
          'answers',
          'result',
          'source',
          'followUp',
          'createdAt',
          'completedAt'
        ]) &&
        isValidTestType(request.resource.data.testType) &&
        request.resource.data.testVersion == '2026-05-14' &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.contact.keys().hasOnly([
          'fullName',
          'whatsapp',
          'email',
          'city'
        ]) &&
        request.resource.data.contact.fullName is string &&
        request.resource.data.contact.fullName.size() >= 2 &&
        request.resource.data.contact.fullName.size() <= 140 &&
        request.resource.data.contact.whatsapp is string &&
        request.resource.data.contact.whatsapp.size() >= 8 &&
        request.resource.data.contact.whatsapp.size() <= 40 &&
        request.resource.data.contact.email is string &&
        request.resource.data.contact.email.size() <= 180 &&
        request.resource.data.contact.city is string &&
        request.resource.data.contact.city.size() <= 120 &&
        request.resource.data.consent.keys().hasOnly([
          'privacyAccepted',
          'sensitiveDataAccepted',
          'acceptedAt',
          'consentTextVersion'
        ]) &&
        request.resource.data.consent.privacyAccepted == true &&
        request.resource.data.consent.sensitiveDataAccepted == true &&
        request.resource.data.consent.acceptedAt == request.time &&
        request.resource.data.consent.consentTextVersion == '2026-05-14' &&
        request.resource.data.answers is list &&
        request.resource.data.answers.size() == 0 &&
        request.resource.data.result is map &&
        request.resource.data.followUp.keys().hasOnly([
          'status',
          'contacted',
          'notes'
        ]) &&
        request.resource.data.followUp.status == 'in_progress' &&
        request.resource.data.followUp.contacted == false &&
        request.resource.data.followUp.notes == '' &&
        request.resource.data.source.keys().hasOnly([
          'page',
          'path',
          'hash',
          'referrer',
          'utmSource',
          'utmMedium',
          'utmCampaign'
        ]) &&
        request.resource.data.source.page == 'web-gemb' &&
        request.resource.data.source.path is string &&
        request.resource.data.source.hash is string &&
        request.resource.data.source.referrer is string &&
        request.resource.data.source.utmSource is string &&
        request.resource.data.source.utmMedium is string &&
        request.resource.data.source.utmCampaign is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.completedAt == null;
    }

    function isOwnerCompletionUpdate() {
      return request.auth != null &&
        resource.data.createdByUid == request.auth.uid &&
        resource.data.followUp.status == 'in_progress' &&
        resource.data.completedAt == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'answers',
          'result',
          'completedAt',
          'followUp'
        ]) &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.contact == resource.data.contact &&
        request.resource.data.consent == resource.data.consent &&
        request.resource.data.source == resource.data.source &&
        request.resource.data.testType == resource.data.testType &&
        request.resource.data.testVersion == resource.data.testVersion &&
        request.resource.data.answers is list &&
        request.resource.data.answers.size() > 0 &&
        request.resource.data.result is map &&
        request.resource.data.completedAt == request.time &&
        request.resource.data.followUp.diff(resource.data.followUp).affectedKeys().hasOnly([
          'status'
        ]) &&
        request.resource.data.followUp.status == 'new' &&
        request.resource.data.followUp.contacted == resource.data.followUp.contacted &&
        request.resource.data.followUp.notes == resource.data.followUp.notes;
    }

    function isAdminFollowUpUpdate() {
      return isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'followUp'
        ]) &&
        request.resource.data.followUp.diff(resource.data.followUp).affectedKeys().hasOnly([
          'status',
          'contacted',
          'notes'
        ]) &&
        isValidFollowUpStatus(request.resource.data.followUp.status) &&
        request.resource.data.followUp.contacted is bool &&
        request.resource.data.followUp.notes is string &&
        request.resource.data.followUp.notes.size() <= 5000;
    }

    match /testResponses/{docId} {
      allow create: if isValidLeadCreate();
      allow read: if isAdmin();
      allow update: if isOwnerCompletionUpdate() || isAdminFollowUpUpdate();
      allow delete: if false;
    }

    match /adminUsers/{uid} {
      allow read: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
